<?xml version="1.0" encoding="UTF-8"?>
<!--
  Preset & Profit – Missed Call Recovery: Twilio Voice TwiML
  Paste this into a Twilio TwiML Bin, then set the client's number's
  "A CALL COMES IN" handler to this Bin.

  How it works:
  - Inbound call to the Twilio number is forwarded (Dial) to the owner's real cell.
  - timeout="20" = ring the owner for 20s. If they don't pick up (no-answer/busy/failed),
    Twilio requests the `action` URL with DialCallStatus set.
  - n8n's webhook receives that POST, sees DialCallStatus != completed, and texts the caller.
  - n8n returns an empty <Response/>, ending the call (or add voicemail below).

  REPLACE before saving:
    {{OWNER_CELL_E164}}  -> the owner's real mobile, e.g. +14805551234
    {{N8N_WEBHOOK_URL}}  -> your production n8n webhook, e.g.
                            https://yourname.app.n8n.cloud/webhook/missed-call-recovery
-->
<Response>
  <Dial timeout="20" answerOnBridge="true" callerId="{{TWILIO_NUMBER_E164}}"
        action="{{N8N_WEBHOOK_URL}}" method="POST">
    <Number>{{OWNER_CELL_E164}}</Number>
  </Dial>
  <!-- Optional voicemail fallback if you prefer capturing audio too:
  <Say voice="Polly.Joanna">Sorry we missed you. We just sent you a text - reply and we'll help right away.</Say>
  -->
</Response>
