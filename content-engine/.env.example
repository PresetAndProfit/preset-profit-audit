# Preset & Profit — Content OS environment
# Copy to `.env` (the CLI auto-loads it) or just run:  node cli.js setup
# Everything is OPTIONAL: with nothing set, the engine runs on a local JSON
# store + template captions. Check what's wired up any time:  node cli.js setup-status

# ---- Active brand profile (niche) ----
# One of: b7squad (default) | dealership | detailing | realestate | restaurant |
#         barbershop | photographer | hvac
# Override per-command with: node cli.js <cmd> --profile <id>
CONTENT_PROFILE=b7squad

# ---- Operating mode ----
# local | sheets | instagram — set by `node cli.js setup`. Informational: it
# tells setup-status what to expect. Storage still auto-selects Sheets vs local.
CONTENT_MODE=local

# Your brand's Instagram handle (display only, no @).
INSTAGRAM_HANDLE=

# ---- AI caption generation ----
# Generation uses Anthropic/Claude. Without a key, the built-in template writer
# produces the captions and the whole pipeline still works.
ANTHROPIC_API_KEY=
# Model id (defaults to a current Claude model if unset).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Accepted and stored for future use.
OPENAI_API_KEY=

# ---- Google Sheets (optional — local JSON store used if unset) ----
# The spreadsheet ID (the long token between /d/ and /edit in the sheet URL).
GSHEET_CONTENT_ID=
# Tab/worksheet name inside that spreadsheet.
GSHEET_CONTENT_TAB=Submissions
# Service-account auth. Path to a downloaded JSON key file, OR the inline JSON.
# Share the spreadsheet with the key's client_email address.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
# (Legacy alternatives still honored: GOOGLE_APPLICATION_CREDENTIALS, or
#  GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY with \n escapes.)

# ---- Instagram / Meta Graph API (optional) ----
# When the token + business account id are set, the tagged/mentions/dm adapters
# can poll the Graph API. Without them, those adapters drain the local feed
# queues in feeds/*.jsonl, and you can always import by hand:
#   node cli.js intake-manual      (see INSTAGRAM_SETUP.md for the full guide)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# ---- Content calendar ----
SCHEDULE_TIME=18:00        # local HH:MM for 1-per-day auto-scheduling
SCHEDULE_PER_DAY=1         # posts per day (multiple spread across 9:00–19:00)

# ---- Local web approval UI ----
PORT=4317
