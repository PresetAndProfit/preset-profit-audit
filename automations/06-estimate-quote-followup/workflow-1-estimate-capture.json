      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-300, 980],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED", "name": "P&P Google Sheets" } },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Tally an estimate-view ping. Alerts the owner once views cross the threshold.\nconst c = $('Find Quote (View)').first().json || {};\nif (!c.Quote_ID) return []; // unknown quote id -> ignore\nconst views = Number(c.Views || 0) + 1;\nconst threshold = Number($env.VIEW_ALERT_THRESHOLD || 3);\nconst alreadyAlerted = String(c.View_Alerted || '').toLowerCase() === 'yes';\nconst alert = views >= threshold && !alreadyAlerted;\nreturn [{ json: { quote_id: c.Quote_ID, customer_name: c.Customer_Name || '', customer_phone: c.Customer_Phone || '', estimate_amount: c.Estimate_Amount || '', service_type: c.Service_Type || '', views, alert } }];"
      },
      "id": "node-tally-view",
      "name": "Tally View",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-60, 980]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "={{ $env.GSHEET_QUOTES_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Quotes", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["Quote_ID"],
          "value": {
            "Quote_ID": "={{ $json.quote_id }}",
            "Views": "={{ $json.views }}",
            "Last_Viewed_At": "={{ $now.toISO() }}",
            "View_Alerted": "={{ $json.alert ? 'Yes' : ($('Find Quote (View)').first().json.View_Alerted || 'No') }}"
          }
        },
        "options": {}
      },
      "id": "node-update-view",
      "name": "Update Views",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [180, 980],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GSHEETS_CRED", "name": "P&P Google Sheets" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "typeValidation": "loose" },
          "conditions": [ { "leftValue": "={{ $('Tally View').item.json.alert }}", "rightValue": "true", "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-view-alert",
      "name": "Viewed Repeatedly?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [420, 980]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.OWNER_EMAIL }}",
        "subject": "=👀 Estimate viewed {{ $('Tally View').item.json.views }}x – {{ $('Tally View').item.json.customer_name || $('Tally View').item.json.customer_phone }} (${{ $('Tally View').item.json.estimate_amount }})",
        "emailType": "text",
        "message": "=This customer keeps re-opening their estimate — a strong buying signal:\n\nName: {{ $('Tally View').item.json.customer_name }}\nPhone: {{ $('Tally View').item.json.customer_phone }}\nService: {{ $('Tally View').item.json.service_type }}\nAmount: ${{ $('Tally View').item.json.estimate_amount }}\nViews: {{ $('Tally View').item.json.views }}\n\nNow is a great time for a quick personal call.",
        "options": {}
      },
      "id": "node-alert-view",
      "name": "Alert Owner (Multiple Views)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [660, 980],
      "credentials": { "gmailOAuth2": { "id": "GMAIL_CRED", "name": "P&P Gmail" } },
      "continueOnFail": true
    }
  ],
