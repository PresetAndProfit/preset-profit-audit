# ===== Preset & Profit – Estimate / Quote Follow-Up Engine: Environment Variables =====
# Set in n8n (Settings > Variables on Cloud, or env on self-hosted). One set per client.

# --- Business identity ---
BUSINESS_NAME="Acme Roofing"
BUSINESS_INDUSTRY="roofing / exterior contracting"
OWNER_EMAIL="owner@acmeroofing.com"
OWNER_PHONE="+14805550111"          # for HOT-lead owner SMS alerts (E.164)
BOOKING_LINK="https://acmeroofing.com/schedule"

# --- Twilio ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"

# --- OpenAI ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets ---
GSHEET_QUOTES_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- Follow-up sequence (the heart of the automation) ---
FOLLOWUP_DAYS="1,3,7,14,21"          # days after the estimate to send each touch (configurable)
FOLLOWUP_CHANNELS="sms,email,sms,email,sms"  # channel per step; falls back to SMS if no email on file

# --- Owner-alert triggers ---
HIGH_VALUE_ESTIMATE="5000"           # estimates >= this $ amount trigger a capture alert
VIEW_ALERT_THRESHOLD="3"             # alert the owner when an estimate is viewed this many times

# --- Pacing / safety (protects deliverability + carrier standing) ---
DAILY_CAP="200"                      # max follow-up touches per calendar day across all quotes
BUSINESS_HOURS_START="9"             # only send between these hours (24h clock, n8n timezone)
BUSINESS_HOURS_END="19"

# IMPORTANT: set the n8n timezone to the client's local zone (hours gate + daily cap depend on it).

# Credentials live in n8n's encrypted vault:
#   P&P Twilio (twilioApi) · P&P OpenAI (openAiApi) · P&P Google Sheets (googleSheetsOAuth2Api) · P&P Gmail (gmailOAuth2)
