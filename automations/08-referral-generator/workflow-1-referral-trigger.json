      "parameters": {
        "jsCode": "// Eligibility gate (in code, not the prompt): satisfied + complete + no complaint + not opted out + cooldown passed + not staff-blocked.\nconst n = $('Normalize Customer').item.json;\nconst ex = $json || {};\nconst minSat = Number($env.MIN_SATISFACTION || 4);\nconst cooldownDays = Number($env.REFERRAL_COOLDOWN_DAYS || 90);\nconst sat = Number(n.satisfaction_score || 0);\nconst reviewPos = ['positive','happy','satisfied','5','4'].some(s => String(n.review_status || '').toLowerCase().includes(s));\nconst satisfied = sat >= minSat || reviewPos;\nconst complete = !!n.completion_date || String(n.status || '').toLowerCase().includes('complete');\nconst complaint = String(ex.Complaint || '').toLowerCase() === 'yes';\nconst optedOut = String(ex.Opted_Out || '').toLowerCase() === 'yes';\nconst lastReq = ex.Last_Request_At ? new Date(ex.Last_Request_At).getTime() : 0;\nconst cooldownOk = !lastReq || ($now.toMillis() - lastReq) >= cooldownDays * 86400000;\nconst staffBlock = String(ex.Referral_Eligible || '').toLowerCase() === 'no' && String(ex.Status || '').toLowerCase().includes('not eligible');\nconst reasons = [];\nif (!satisfied) reasons.push('not satisfied');\nif (!complete) reasons.push('job not complete');\nif (complaint) reasons.push('unresolved complaint');\nif (optedOut) reasons.push('opted out');\nif (!cooldownOk) reasons.push('within referral cooldown');\nif (staffBlock) reasons.push('staff marked not eligible');\nconst eligible = reasons.length === 0;\nconst delayMin = Number($env.REQUEST_DELAY_MIN || 60);\nreturn [{ json: { ...n, is_new: !ex.Customer_ID, prev_complaint: complaint ? 'Yes' : 'No', prev_optout: optedOut ? 'Yes' : 'No', eligible, reason: reasons.join('; ') || 'eligible', next_request_at: $now.plus({ minutes: delayMin }).toISO() } }];"
      },
