    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "=You analyze a customer's SMS reply to a friendly nurture/check-in message from {{ $env.BUSINESS_NAME }}, a {{ $env.BUSINESS_INDUSTRY }} business. Their segment/notes: {{ $('Find Contact (Reply)').first().json.Segment || 'general' }}. Return STRICT JSON only. Schema: {\"class\":\"BOOK|INTERESTED|QUESTION|NOT_NOW|UNSUBSCRIBE|GENERAL\",\"sentiment\":\"positive|neutral|negative\",\"wants_service\":true|false,\"summary\":\"one sentence for the owner\",\"suggested_reply\":\"warm, helpful, 1-2 sentence SMS under 300 chars. If BOOK or INTERESTED, be enthusiastic and say someone from the team will reach out to help/schedule. If QUESTION, answer helpfully or say the team will follow up. If NOT_NOW, be gracious and say we'll stay in touch. NEVER invent prices, discounts, dates, or guarantees.\"}. No text outside the JSON object."
            },
            { "role": "user", "content": "=Customer reply: \"{{ $('Normalize Reply').item.json.message_body }}\"" }
          ]
        },
        "jsonOutput": true,
        "options": { "temperature": 0.3 }
      },
      "id": "node-classify",
      "name": "Classify Reply (AI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [120, 760],
      "credentials": { "openAiApi": { "id": "OPENAI_CRED", "name": "P&P OpenAI" } }
    },
    {
      "parameters": {
        "jsCode": "const ai = $('Classify Reply (AI)').first().json.message?.content ?? $('Classify Reply (AI)').first().json;\nlet p;\ntry { p = typeof ai === 'string' ? JSON.parse(ai) : ai; }\ncatch (e) { p = { class:'GENERAL', sentiment:'neutral', wants_service:false, summary:'Could not parse AI output', suggested_reply:'Thanks for getting back to us — a team member will follow up shortly!' }; }\nconst r = $('Normalize Reply').item.json;\nconst c = $('Find Contact (Reply)').first().json || {};\nconst cls = String(p.class || 'GENERAL').toUpperCase();\nconst convo = ((c.Conversation || '') + `\\nIN: ${r.message_body}\\nOUT: ${p.suggested_reply}`).trim();\nconst unsub = cls === 'UNSUBSCRIBE';\nconst hot = cls === 'BOOK' || cls === 'INTERESTED' || p.wants_service === true;\nconst statusMap = { BOOK:'Re-Engaged - Hot Lead', INTERESTED:'Re-Engaged - Interested', QUESTION:'Replied - Question', NOT_NOW:'Replied - Not Now', UNSUBSCRIBE:'Unsubscribed', GENERAL:'Replied - General' };\n// A hot re-engagement pauses the nurture drip (they're now a live lead for the owner); unsubscribe stops it permanently.\nconst sequence_active = (hot || unsub) ? 'No' : 'Yes';\nconst opted_out = unsub ? 'Yes' : (String(c.Opted_Out || 'No'));\nconst wants_contact = /call me|contact me|reach me|call back|text me/i.test(r.message_body || '');\nconst alert_owner = hot || wants_contact;\nreturn [{ json: { class: cls, sentiment: p.sentiment || 'neutral', hot, unsub, wants_service: !!p.wants_service, summary: p.summary || '', suggested_reply: p.suggested_reply || 'Thanks for your reply!', customer_phone: r.customer_phone, message_body: r.message_body, customer_name: c.Customer_Name || '', segment: c.Segment || '', conversation: convo, new_status: statusMap[cls] || 'Replied - General', sequence_active, opted_out, alert_owner } }];"
      },
