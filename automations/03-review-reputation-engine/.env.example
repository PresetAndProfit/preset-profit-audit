# ===== Preset & Profit – Review & Reputation Engine: Environment Variables =====
# Set in n8n (Settings > Variables on Cloud, or env on self-hosted). One set per client.

# --- Business identity ---
BUSINESS_NAME="Acme HVAC"
BUSINESS_INDUSTRY="HVAC / heating & cooling"
OWNER_EMAIL="owner@acmehvac.com"

# --- The Google review link (CRITICAL) ---
# Get from Google Business Profile > Ask for reviews > copy link, or build:
#   https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
GOOGLE_REVIEW_LINK="https://g.page/r/AcmeHVAC/review"

# --- Twilio ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"

# --- OpenAI ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets ---
GSHEET_REVIEWS_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- Timing / behavior ---
REVIEW_DELAY_MIN="120"          # minutes after job completion before asking (default 2h)
REVIEW_REMINDER_MIN="1440"      # minutes before one reminder if no reply (24h)
BUSINESS_HOURS_START="9"        # only send requests between these hours (24h clock, n8n timezone)
BUSINESS_HOURS_END="19"

# IMPORTANT: set the n8n instance/workflow Timezone (Settings) to the client's local zone
# so BUSINESS_HOURS_* and Send_At behave correctly.

# Credentials live in n8n's encrypted vault:
#   P&P Twilio (twilioApi) · P&P OpenAI (openAiApi) · P&P Google Sheets (googleSheetsOAuth2Api) · P&P Gmail (gmailOAuth2)
