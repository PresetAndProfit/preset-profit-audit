# ===== Preset & Profit – Missed Call Recovery: Environment Variables =====
# Set these in n8n: Settings > Variables (Cloud) OR as env vars on self-hosted.
# One value set PER CLIENT. Clone the workflow per client OR drive these from the Config sheet.

# --- Business identity (per client) ---
BUSINESS_NAME="Acme HVAC"
BUSINESS_INDUSTRY="HVAC / heating & cooling"
BUSINESS_SERVICE_AREA="Phoenix, AZ metro"
OWNER_EMAIL="owner@acmehvac.com"
OWNER_SMS="+14805551234"          # optional: owner mobile for SMS alerts
BOOKING_LINK="https://acmehvac.com/book"

# --- Twilio ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"      # the client's Twilio number (also their forwarding line)

# --- OpenAI ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets ---
GSHEET_LEADS_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"   # spreadsheet ID from the URL

# --- Follow-up behavior ---
MAX_FOLLOW_UPS="2"                # number of follow-ups before marking Cold
FOLLOW_UP_GAP_MIN="1440"          # minutes between follow-ups (1440 = 24h)
FIRST_FOLLOW_UP_MIN="30"          # minutes after first SMS before follow-up #1

# --- Webhook security (recommended) ---
TWILIO_VALIDATION_TOKEN="set_a_shared_secret_or_use_twilio_signature"

# Credentials NOT stored here (stored inside n8n credential vault):
#   - P&P Twilio (twilioApi)
#   - P&P OpenAI (openAiApi)
#   - P&P Google Sheets (googleSheetsOAuth2Api)
#   - P&P Gmail (gmailOAuth2)
