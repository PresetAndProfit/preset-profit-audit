# ===== Preset & Profit – Appointment Reminder & No-Show Recovery: Environment Variables =====
# Set in n8n (Settings > Variables on Cloud, or env on self-hosted). One set per client.

# --- Business identity ---
BUSINESS_NAME="Acme Dental"
BUSINESS_INDUSTRY="dental practice"
OWNER_EMAIL="frontdesk@acmedental.com"

# --- Twilio ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"

# --- OpenAI ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets ---
GSHEET_APPTS_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- Reminder + no-show timing (minutes) ---
REMINDER_LEAD_1_MIN="1440"      # first reminder this many minutes before appt (24h)
REMINDER_LEAD_2_MIN="120"       # second reminder before appt (2h)
NOSHOW_GRACE_MIN="30"           # minutes after appt time before treating an unconfirmed appt as a no-show

# IMPORTANT: set the n8n instance/workflow Timezone to the client's local zone so Appt_Time
# math and reminder windows are correct. Appt_Time should be stored in ISO 8601.

# Credentials live in n8n's encrypted vault:
#   P&P Twilio (twilioApi) · P&P OpenAI (openAiApi) · P&P Google Sheets (googleSheetsOAuth2Api) · P&P Gmail (gmailOAuth2)
