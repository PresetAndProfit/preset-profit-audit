# ============================================================================
# Preset & Profit — environment variables
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Put the SAME values in Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Anything WITHOUT the VITE_ prefix is server-only.
# ============================================================================

# --- Supabase (client) ------------------------------------------------------
# Safe to expose to the browser. Supabase Dashboard → Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (server only) -------------------------------------------------
# SECRET. Service-role key bypasses Row Level Security — used only inside /api.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- App base URL -----------------------------------------------------------
# Used to build Stripe success/cancel/return URLs. Local dev = localhost:5173;
# in Vercel set it to your deployed domain (e.g. https://app.presetandprofit.com).
APP_URL=http://localhost:5173

# --- Stripe -----------------------------------------------------------------
# Secret key (server only): Stripe → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_xxx
# Publishable key (client, optional today — reserved for embedded Stripe.js).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Price IDs (server only). Generate with: npm run setup:stripe
# (or create Products manually in the Stripe Dashboard and paste the price_… ids)
STRIPE_PRICE_PROFESSIONAL=price_xxx_professional
STRIPE_PRICE_AGENCY=price_xxx_agency

# Webhook signing secret (server only).
#   Local:  stripe listen --forward-to localhost:5173/api/stripe/webhook  → whsec_…
#   Prod:   Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Anthropic / Claude (server only) ---------------------------------------
# Powers the AI audit consultant: classifies the business and writes findings
# grounded in the scraped site (api/_lib/aiFindings.js). If unset, the audit
# engine falls back to the deterministic archetype templates — the app still
# works, reports are just less specific. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Admin Command Center (server only) -------------------------------------
# Extra admin emails (comma-separated). justin@presetprofit.com is always an
# admin; this is for granting additional operators without setting profiles.is_admin.
# ADMIN_EMAILS=teammate@presetprofit.com

# --- Email (Tier 4 — not used yet) ------------------------------------------
# RESEND_API_KEY=re_xxx
