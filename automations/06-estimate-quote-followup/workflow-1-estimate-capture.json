    {
      "parameters": {
        "jsCode": "// Normalize an estimate/quote from any source: Sheet, manual, generic webhook,\n// Jobber, ServiceTitan, Housecall Pro, GoHighLevel. Flat + common nested shapes.\nconst b = $json.body || {};\nconst q = $json.query || {};\n// Merge likely nested containers so a single pick() sees them all.\nconst nests = [b, b.data, b.client, b.customer, b.contact, b.estimate, b.quote, b.job, b.opportunity, b.deal, q].filter(Boolean);\nconst pick = (...keys) => { for (const src of nests) { for (const k of keys) { const v = src && src[k]; if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim(); } } return ''; };\nlet name = pick('customer_name','customerName','client_name','name','full_name','fullName','contactName');\nconst first = pick('first_name','firstName');\nconst last = pick('last_name','lastName');\nif (!name && (first || last)) name = `${first} ${last}`.trim();\nlet phone = pick('phone','phone_number','phoneNumber','mobile','mobile_phone','cell');\nconst digits = phone.replace(/[^0-9]/g, '');\nif (digits.length === 10) phone = '+1' + digits;\nelse if (digits.length === 11 && digits.startsWith('1')) phone = '+' + digits;\nelse if (phone && !phone.startsWith('+')) phone = digits ? '+' + digits : '';\nconst email = pick('email','email_address','emailAddress','customer_email');\nconst service = pick('service','service_type','serviceType','job_type','jobType','category','title','line_item','description');\n// Amount: handle $, commas, monetaryValue (GHL), total (ServiceTitan/Jobber)\nlet amountRaw = pick('estimate_amount','amount','total','quote_total','quoteAmount','price','value','monetaryValue','grand_total','grandTotal');\nconst amount = Number(String(amountRaw).replace(/[^0-9.]/g, '')) || 0;\nconst estimateDate = pick('estimate_date','estimateDate','created_at','createdAt','date','sent_at','issued_at') || $now.toISODate();\nconst expirationDate = pick('expiration_date','expirationDate','expires_at','expiresAt','valid_until','validUntil','expiry');\nconst rep = pick('assigned_rep','assignedRep','rep','salesperson','sales_rep','owner','assigned_to','assignedTo','user');\nlet status = pick('status','stage','state','pipeline_stage') || 'New';\nconst source = pick('source','provider','integration') || q.source || 'Webhook';\n// Stable dedup key: prefer the source's own id, else phone+amount.\nconst extId = pick('quote_id','quoteId','estimate_id','estimateId','id','opportunity_id','opportunityId','deal_id','number','quote_number');\nconst quoteId = extId ? `${source}-${extId}` : (digits ? `${digits.slice(-10)}-${Math.round(amount)}` : `${$now.toMillis()}`);\nreturn [{ json: { quote_id: quoteId, name, phone, email, service, amount, estimate_date: estimateDate, expiration_date: expirationDate, assigned_rep: rep, source, source_status: status, received_at: $now.toISO() } }];"
      },
      "id": "node-normalize",
      "name": "Normalize Estimate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 200]
