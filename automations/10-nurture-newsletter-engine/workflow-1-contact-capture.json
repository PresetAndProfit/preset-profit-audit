    {
      "parameters": {
        "jsCode": "// Normalize a contact from any source: CRM, Jobber, ServiceTitan, Housecall Pro, GoHighLevel,\n// a completed job, a lead form, or a sheet/manual add. Dedup key = Contact_ID.\nconst b = $json.body || {};\nconst q = $json.query || {};\nconst nests = [b, b.data, b.contact, b.customer, b.client, b.object, q].filter(Boolean);\nconst pick = (...keys) => { for (const src of nests) { for (const k of keys) { const v = src && src[k]; if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim(); } } return ''; };\nlet name = pick('customer_name','customerName','client_name','name','full_name','contact_name');\nconst first = pick('first_name','firstName'); const last = pick('last_name','lastName');\nif (!name && (first || last)) name = `${first} ${last}`.trim();\nlet phone = pick('phone','phone_number','phoneNumber','mobile','cell');\nconst digits = phone.replace(/[^0-9]/g, '');\nif (digits.length === 10) phone = '+1' + digits; else if (digits.length === 11 && digits.startsWith('1')) phone = '+' + digits; else if (phone && !phone.startsWith('+')) phone = digits ? '+' + digits : '';\nconst email = pick('email','customer_email','email_address','contact_email');\nconst segment = pick('segment','tags','tag','list','type','customer_type','category');\nconst lastService = pick('last_service','service','service_type','job_type','last_job','service_name','plan');\nconst lastServiceDate = pick('service_date','completed_at','last_service_date','job_date','date');\nconst source = pick('source','provider','integration') || q.source || 'Webhook';\nconst extId = pick('contact_id','contactId','id','customer_id','Id');\nconst contactId = extId ? `${source}-${extId}` : (digits ? `C-${digits.slice(-10)}` : (email ? `C-${email.toLowerCase()}` : `${$now.toMillis()}`));\n// First touch starts after a short delay; the recurring cadence (NURTURE_INTERVAL_DAYS) takes over from there.\nconst firstDays = Number($env.NURTURE_FIRST_TOUCH_DAYS || 3);\nconst nextTouch = new Date($now.toMillis() + firstDays * 86400000).toISOString();\nreturn [{ json: { contact_id: contactId, name, phone, email, segment, last_service: lastService, last_service_date: lastServiceDate, source, next_touch_at: nextTouch, received_at: $now.toISO() } }];"
      },
