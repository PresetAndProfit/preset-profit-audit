# ===== Preset & Profit – Long-Term Nurture & Newsletter Engine: Environment Variables =====
# Set in n8n (Settings > Variables on Cloud, or env on self-hosted). One set per client.

# --- Business identity (also steers the AI content angle) ---
BUSINESS_NAME="Acme Heating & Cooling"
BUSINESS_INDUSTRY="residential HVAC"     # drives seasonal/maintenance content (e.g. AC tune-ups, recall, market updates)
OWNER_EMAIL="owner@acmehvac.com"
OWNER_PHONE="+14805550111"               # for re-engaged / hot-reply SMS alerts (E.164)

# --- Twilio ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"

# --- OpenAI (generates the nurture content + classifies replies) ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets ---
GSHEET_CONTACTS_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- Nurture cadence (long-term: weeks/months between touches) ---
NURTURE_INTERVAL_DAYS="30"               # base cadence between value/seasonal touches per contact
NURTURE_FIRST_TOUCH_DAYS="3"             # delay before the very first touch after a contact is captured
NURTURE_CHANNELS="email,sms"             # rotates by touch index; falls back to whatever the contact has
MAX_TOUCHES="0"                          # 0 = evergreen (nurture forever); set N to stop after N touches
FREQUENCY_CAP_DAYS=""                    # min days between ANY two messages to one contact; blank = max(7, interval/2)

# --- Owner alerts ---
# A reply classified BOOK / INTERESTED (or "call me") pauses nurture + emails the owner the hot lead.

# --- Pacing / compliance (TCPA-safe) ---
DAILY_CAP="200"                          # max nurture touches per calendar day across all contacts
BUSINESS_HOURS_START="9"                 # only send between these hours (24h clock, n8n timezone)
BUSINESS_HOURS_END="18"

# IMPORTANT: set the n8n timezone to the client's local zone (hours gate + cadence math depend on it).

# Credentials live in n8n's encrypted vault:
#   P&P Twilio (twilioApi) · P&P OpenAI (openAiApi) · P&P Google Sheets (googleSheetsOAuth2Api) · P&P Gmail (gmailOAuth2)
