    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "=You analyze a customer's reply to an estimate/quote follow-up from {{ $env.BUSINESS_NAME }}, a {{ $env.BUSINESS_INDUSTRY }} business. The customer was quoted ${{ $('Find Quote (Reply)').first().json.Estimate_Amount || 'unknown' }} for {{ $('Find Quote (Reply)').first().json.Service_Type || 'a job' }}. Return STRICT JSON only. Schema: {\"interest\":\"HOT|WARM|COLD|DECLINED\",\"intent\":\"accept|negotiate|question|schedule_call|not_now|decline|other\",\"wants_call\":true|false,\"objection\":\"price|timing|trust|scope|none\",\"summary\":\"one sentence for the owner\",\"suggested_reply\":\"warm, helpful 1-2 sentence SMS under 300 chars; if HOT/accept, drive to booking {{ $env.BOOKING_LINK }}; if objection, acknowledge it and offer to help; if DECLINED, politely thank them and stop; never pushy, never invent prices or discounts\"}. HOT = ready to move forward or accepting. WARM = interested with a question/objection. COLD = vague/stalling. DECLINED = clear no. No text outside the JSON object."
            },
            { "role": "user", "content": "=Prior conversation:\n{{ $('Find Quote (Reply)').first().json.Conversation || 'none' }}\n\nCustomer reply: \"{{ $('Normalize Reply').item.json.message_body }}\"" }
          ]
        },
        "jsonOutput": true,
        "options": { "temperature": 0.3 }
      },
      "id": "node-classify",
      "name": "Classify Reply (AI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [180, 660],
      "credentials": { "openAiApi": { "id": "OPENAI_CRED", "name": "P&P OpenAI" } }
    },
    {
      "parameters": {
        "jsCode": "const ai = $('Classify Reply (AI)').first().json.message?.content ?? $('Classify Reply (AI)').first().json;\nlet p;\ntry { p = typeof ai === 'string' ? JSON.parse(ai) : ai; }\ncatch (e) { p = { interest:'WARM', intent:'other', wants_call:false, objection:'none', summary:'Could not parse AI output', suggested_reply:'Thanks for getting back to us! A team member will follow up shortly.' }; }\nconst r = $('Normalize Reply').item.json;\nconst c = $('Find Quote (Reply)').first().json;\nconst convo = ((c.Conversation || '') + `\\nIN: ${r.message_body}\\nOUT: ${p.suggested_reply}`).trim();\nconst interest = String(p.interest || 'WARM').toUpperCase();\nconst statusMap = { HOT:'Replied - Hot', WARM:'Replied - Warm', COLD:'Replied - Cold', DECLINED:'Declined' };\nconst terminal = interest === 'DECLINED' || p.intent === 'accept' || p.intent === 'decline';\nconst won = p.intent === 'accept';\nconst alertOwner = interest === 'HOT' || p.wants_call === true || won || (p.objection && p.objection !== 'none');\nconst newStatus = won ? 'Won - Accepted' : (statusMap[interest] || 'Replied - Warm');\nreturn [{ json: { interest, intent: p.intent || 'other', wants_call: !!p.wants_call, objection: p.objection || 'none', summary: p.summary || '', suggested_reply: p.suggested_reply || 'Thanks! We will follow up shortly.', customer_phone: r.customer_phone, message_body: r.message_body, customer_name: c.Customer_Name || '', estimate_amount: c.Estimate_Amount || '', service_type: c.Service_Type || '', assigned_rep: c.Assigned_Rep || '', conversation: convo, new_status: newStatus, sequence_active: terminal ? 'No' : 'Yes', won: won ? 'Yes' : 'No', alert_owner: alertOwner } }];"
      },
      "id": "node-parse-reply",
      "name": "Parse Reply",
      "type": "n8n-nodes-base.code",
