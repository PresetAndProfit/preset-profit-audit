# ===== Preset & Profit – Invoice & Payment Reminder (AR): Environment Variables =====
# Set in n8n (Settings > Variables on Cloud, or env on self-hosted). One set per client.

# --- Business identity ---
BUSINESS_NAME="Acme Contracting"
BUSINESS_INDUSTRY="general contracting"
OWNER_EMAIL="owner@acmecontracting.com"
OWNER_PHONE="+14805550111"            # for high-value / disputed invoice SMS alerts (E.164)

# --- Twilio ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"

# --- OpenAI ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets ---
GSHEET_INVOICES_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- Reminder schedule (offsets in DAYS from the invoice Due_Date) ---
REMINDER_DAYS="0,3,7,14"               # on due date, then +3 / +7 / +14 days past due (negative = courtesy pre-due)
REMINDER_CHANNELS="sms,email,sms,email"  # channel per step; falls back to SMS if no email on file
PROMISE_SNOOZE_DAYS="5"                # if a customer promises to pay, pause reminders this many days

# --- Owner alerts ---
HIGH_VALUE_INVOICE="2500"              # balances >= this $ amount trigger a capture alert

# --- Optional late-fee language (LEAVE BLANK unless the client actually charges one) ---
LATE_FEE_TEXT=""                       # e.g. "A 1.5% monthly late fee applies per our terms." Only ever sent when set.

# --- Pacing / compliance (TCPA-safe) ---
DAILY_CAP="200"                        # max reminder touches per calendar day across all invoices
BUSINESS_HOURS_START="9"               # only send between these hours (24h clock, n8n timezone)
BUSINESS_HOURS_END="19"

# IMPORTANT: set the n8n timezone to the client's local zone (hours gate + due-date math depend on it).

# Credentials live in n8n's encrypted vault:
#   P&P Twilio (twilioApi) · P&P OpenAI (openAiApi) · P&P Google Sheets (googleSheetsOAuth2Api) · P&P Gmail (gmailOAuth2)
