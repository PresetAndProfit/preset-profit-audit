# ===== Preset & Profit – Referral Generator Engine: Environment Variables =====
# Set in n8n (Settings > Variables on Cloud, or env on self-hosted). One set per client.

# --- Business identity ---
BUSINESS_NAME="Acme Dental"
BUSINESS_INDUSTRY="dental practice"
OWNER_EMAIL="owner@acmedental.com"
OWNER_PHONE="+14805550111"            # for high-value/urgent referral SMS alerts (E.164)
BOOKING_LINK="https://acmedental.com/book"

# --- Referral specifics ---
REFERRAL_LINK="https://acmedental.com/refer"   # the form/landing page where customers submit a referral
REFERRAL_INCENTIVE=""                  # LEAVE BLANK unless the client offers a reward. e.g. "you'll both get $25 off your next visit"
                                       # The copy + AI only ever mention a reward when this is set (no fabricated incentives).

# --- Twilio ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"

# --- OpenAI ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets ---
GSHEET_REFERRALS_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- Eligibility gate (when it's OK to ask) ---
MIN_SATISFACTION="4"                   # 1-5 score threshold; a positive review_status also qualifies
REFERRAL_COOLDOWN_DAYS="90"            # don't re-ask the same customer within this many days
REQUEST_DELAY_MIN="60"                 # wait this long after a completed job before the first ask (minutes)

# --- Request sequence ---
REQUEST_DAYS="0,3,7"                   # initial (0 = the delay above), reminder +3d, final +7d
REQUEST_CHANNELS="sms,email,sms"       # channel per step; falls back to SMS if no email on file

# --- Pacing / compliance (TCPA-safe) ---
DAILY_CAP="200"                        # max referral touches per calendar day across all customers
BUSINESS_HOURS_START="9"               # only send between these hours (24h clock, n8n timezone)
BUSINESS_HOURS_END="19"

# IMPORTANT: set the n8n timezone to the client's local zone (hours gate + cooldown + due math depend on it).

# Credentials live in n8n's encrypted vault:
#   P&P Twilio (twilioApi) · P&P OpenAI (openAiApi) · P&P Google Sheets (googleSheetsOAuth2Api) · P&P Gmail (gmailOAuth2)
