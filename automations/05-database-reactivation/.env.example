# ===== Preset & Profit – Database Reactivation Campaign: Environment Variables =====
# Set in n8n (Settings > Variables on Cloud, or env on self-hosted). One set per client/campaign.

# --- Business identity ---
BUSINESS_NAME="Acme HVAC"
BUSINESS_INDUSTRY="HVAC / heating & cooling"
OWNER_EMAIL="owner@acmehvac.com"
BOOKING_LINK="https://acmehvac.com/book"

# --- The offer (the hook of the campaign) ---
OFFER="Book a tune-up this month and get $50 off"

# --- Twilio ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"

# --- OpenAI ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets ---
GSHEET_CONTACTS_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- Throttle + compliance pacing (protects deliverability + carrier standing) ---
BATCH_SIZE="20"                 # max messages per 10-min run
DAILY_CAP="100"                 # max messages per calendar day (warm up: start low, raise over days)
SEND_GAP_SEC="2"                # seconds between individual sends
BUSINESS_HOURS_START="9"        # only send between these hours (24h clock, n8n timezone)
BUSINESS_HOURS_END="19"

# IMPORTANT: set the n8n timezone to the client's local zone (hours gate + daily cap depend on it).

# Credentials live in n8n's encrypted vault:
#   P&P Twilio (twilioApi) · P&P OpenAI (openAiApi) · P&P Google Sheets (googleSheetsOAuth2Api) · P&P Gmail (gmailOAuth2)
