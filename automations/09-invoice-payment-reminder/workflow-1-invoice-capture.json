    {
      "parameters": {
        "jsCode": "// Normalize an invoice from any source: QuickBooks, Stripe, Square, Jobber, CRM, Sheet, manual.\nconst b = $json.body || {};\nconst q = $json.query || {};\nconst nests = [b, b.data, b.invoice, b.object, b.customer, b.client, q].filter(Boolean);\nconst pick = (...keys) => { for (const src of nests) { for (const k of keys) { const v = src && src[k]; if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim(); } } return ''; };\nconst num = v => Number(String(v).replace(/[^0-9.]/g, '')) || 0;\nlet name = pick('customer_name','customerName','client_name','name','customer','bill_to');\nconst first = pick('first_name','firstName'); const last = pick('last_name','lastName');\nif (!name && (first || last)) name = `${first} ${last}`.trim();\nlet phone = pick('phone','phone_number','phoneNumber','mobile','cell');\nconst digits = phone.replace(/[^0-9]/g, '');\nif (digits.length === 10) phone = '+1' + digits; else if (digits.length === 11 && digits.startsWith('1')) phone = '+' + digits; else if (phone && !phone.startsWith('+')) phone = digits ? '+' + digits : '';\nconst email = pick('email','customer_email','email_address','BillEmail','receiver_email');\nconst invNo = pick('invoice_number','number','DocNumber','invoiceNumber','doc_number');\nconst amount = num(pick('amount','total','TotalAmt','amount_due','total_amount','grand_total','balance_due') || '0');\nconst amountPaid = num(pick('amount_paid','AmountPaid','paid') || '0');\nlet balance = num(pick('balance','Balance','amount_remaining','balance_due') || '');\nif (!balance) balance = Math.max(0, amount - amountPaid);\n// Due date: accept ISO or unix seconds.\nlet dueRaw = pick('due_date','DueDate','dueDate','due','duedate');\nlet dueMs = NaN;\nif (/^\\d{9,11}$/.test(dueRaw)) dueMs = Number(dueRaw) * 1000; else if (dueRaw) dueMs = new Date(dueRaw).getTime();\nconst dueISO = isNaN(dueMs) ? '' : new Date(dueMs).toISOString().slice(0,10);\nconst issue = pick('issue_date','TxnDate','created','issued_at','date');\nconst payLink = pick('pay_link','hosted_invoice_url','public_url','invoice_url','payment_url','paymentLink');\nconst status = pick('status','stage');\nconst source = pick('source','provider','integration') || q.source || 'Webhook';\nconst extId = pick('invoice_id','invoiceId','id','Id');\nconst invoiceId = extId ? `${source}-${extId}` : (invNo ? `${source}-${invNo}` : (digits ? `${digits.slice(-10)}-${Math.round(amount)}` : `${$now.toMillis()}`));\n// First reminder = Due_Date + first offset (REMINDER_DAYS[0]); if no due date, start now.\nconst offsets = (($env.REMINDER_DAYS || '0,3,7,14').split(',')).map(n => Number(n.trim()));\nconst baseMs = isNaN(dueMs) ? $now.toMillis() : dueMs;\nconst nextReminder = new Date(baseMs + (offsets[0] || 0) * 86400000).toISOString();\nreturn [{ json: { invoice_id: invoiceId, name, phone, email, invoice_number: invNo, amount, amount_paid: amountPaid, balance, issue_date: issue, due_date: dueISO, pay_link: payLink, source, source_status: status, next_reminder_at: nextReminder, received_at: $now.toISO() } }];"
      },
