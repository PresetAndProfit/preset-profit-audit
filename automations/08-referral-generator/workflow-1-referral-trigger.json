      "parameters": {
        "jsCode": "// Normalize a completed-job / happy-customer event from any source:\n// completed job, positive review, survey, manual Sheet, CRM, Jobber, ServiceTitan, Housecall Pro, GoHighLevel.\nconst b = $json.body || {};\nconst q = $json.query || {};\nconst nests = [b, b.data, b.client, b.customer, b.contact, b.job, b.opportunity, q].filter(Boolean);\nconst pick = (...keys) => { for (const src of nests) { for (const k of keys) { const v = src && src[k]; if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim(); } } return ''; };\nlet name = pick('customer_name','customerName','client_name','name','full_name','fullName');\nconst first = pick('first_name','firstName'); const last = pick('last_name','lastName');\nif (!name && (first || last)) name = `${first} ${last}`.trim();\nlet phone = pick('phone','phone_number','phoneNumber','mobile','cell');\nconst digits = phone.replace(/[^0-9]/g, '');\nif (digits.length === 10) phone = '+1' + digits; else if (digits.length === 11 && digits.startsWith('1')) phone = '+' + digits; else if (phone && !phone.startsWith('+')) phone = digits ? '+' + digits : '';\nconst email = pick('email','email_address','customer_email');\nconst service = pick('service','service_type','job_type','category','title','description');\nconst completion = pick('completion_date','completed_at','completedAt','job_completed','date_completed','closed_at') || ($now.toISODate());\nconst sat = pick('satisfaction_score','satisfaction','rating','score','nps','stars');\nconst review = pick('review_status','review','sentiment','feedback');\nconst staff = pick('assigned_staff','staff','technician','rep','assigned_to','owner');\nconst status = pick('status','stage','event');\nconst source = pick('source','provider','integration') || q.source || 'Webhook';\nconst extId = pick('customer_id','customerId','id','job_id','jobId','contact_id');\nconst customerId = extId ? `${source}-${extId}` : (digits ? `${digits.slice(-10)}` : `${$now.toMillis()}`);\nreturn [{ json: { customer_id: customerId, name, phone, email, service, completion_date: completion, satisfaction_score: sat, review_status: review, assigned_staff: staff, status, source, received_at: $now.toISO() } }];"
      },
