# ===== Preset & Profit – AI Receptionist (24/7 Voice + Chat): Environment Variables =====
# Set in n8n (Settings > Variables on Cloud, or env on self-hosted). One set per client.
# The voice layer (Vapi/Retell) has its own keys — see voice-agent-config.json + IMPLEMENTATION-PLAYBOOK.

# --- Business identity ---
BUSINESS_NAME="Acme Plumbing"
BUSINESS_INDUSTRY="plumbing / drain & water heater service"
BUSINESS_SERVICE_AREA="the greater Phoenix metro"
BUSINESS_HOURS_TEXT="Mon-Fri 8am-6pm, Sat 9am-2pm"
OWNER_EMAIL="owner@acmeplumbing.com"
OWNER_PHONE="+14805550111"            # on-call cell for emergency alerts (E.164)
FORWARD_NUMBER="+14805550111"         # number the agent can transfer emergencies to (blank = no live transfer)

# --- Twilio (owner alerts; also the published business number, pointed at the voice layer) ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"

# --- OpenAI (web-chat brain; the voice layer uses its own model setting) ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o"

# --- Google ---
GSHEET_RECEPTIONIST_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"
GOOGLE_CALENDAR_ID="primary"          # or the calendar's address, e.g. abc123@group.calendar.google.com

# --- Booking / availability rules ---
TIMEZONE="America/Phoenix"            # MUST match the client's local zone (slot math depends on it)
BUSINESS_HOURS_START="8"              # 24h clock, used to bound bookable slots
BUSINESS_HOURS_END="18"
SLOT_MINUTES="60"                     # appointment length
BOOKING_LEAD_MIN="120"               # minimum notice before a bookable slot (minutes)
MAX_SLOTS_OFFERED="5"                 # how many open times to offer per availability check

# --- Escalation ---
EMERGENCY_KEYWORDS="gas leak, flooding, burst pipe, no heat, sparking, electrical, sewage, carbon monoxide"

# --- Voice layer (referenced by voice-agent-config.json) ---
N8N_WEBHOOK_URL="https://your-n8n-host/webhook/receptionist"  # Backend Webhook (workflow-1) Production URL
VOICE_PROVIDER="vapi"                 # vapi | retell
VAPI_API_KEY="your_vapi_private_key"
ELEVENLABS_VOICE_ID="your_voice_id"

# IMPORTANT: set the n8n timezone AND TIMEZONE above to the client's zone (slot + lead-time math depend on it).

# Credentials live in n8n's encrypted vault:
#   P&P Twilio (twilioApi) · P&P OpenAI (openAiApi) · P&P Google Sheets (googleSheetsOAuth2Api)
#   · P&P Gmail (gmailOAuth2) · P&P Google Calendar (googleCalendarOAuth2Api)
