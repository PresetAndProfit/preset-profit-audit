# ===== Preset & Profit – Lead Capture & Follow-Up Engine: Environment Variables =====
# Set in n8n (Settings > Variables on Cloud, or env on self-hosted). One set per client.

# --- Business identity ---
BUSINESS_NAME="Acme HVAC"
BUSINESS_INDUSTRY="HVAC / heating & cooling"
BUSINESS_SERVICE_AREA="Phoenix, AZ metro"
OWNER_EMAIL="owner@acmehvac.com"
BOOKING_LINK="https://acmehvac.com/book"

# --- Twilio ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_NUMBER="+14805550000"

# --- OpenAI ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Google Sheets ---
GSHEET_LEADS_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- Follow-up sequence ---
FIRST_FOLLOW_UP_MIN="60"               # minutes after intake before follow-up #1
MAX_FOLLOW_UPS="3"                      # number of sequence steps before Cold
FOLLOW_UP_GAPS_MIN="60,1440,4320"      # gaps before steps 1,2,3 (1h, 24h, 72h)
FOLLOW_UP_CHANNELS="sms,email,sms"     # channel per step (must match MAX_FOLLOW_UPS length)

# --- Webhook security (recommended) ---
LEAD_WEBHOOK_SECRET="set_a_shared_secret_query_param_or_header"

# Credentials live in n8n's encrypted vault, not here:
#   P&P Twilio (twilioApi) · P&P OpenAI (openAiApi) · P&P Google Sheets (googleSheetsOAuth2Api) · P&P Gmail (gmailOAuth2)
