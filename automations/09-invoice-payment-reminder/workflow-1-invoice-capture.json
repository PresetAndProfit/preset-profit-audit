    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "=You analyze a customer's SMS reply to a payment reminder from {{ $env.BUSINESS_NAME }}, a {{ $env.BUSINESS_INDUSTRY }} business. The outstanding balance is ${{ $('Find Invoice (Reply)').first().json.Balance || 'unknown' }} on invoice {{ $('Find Invoice (Reply)').first().json.Invoice_Number || '' }}. Return STRICT JSON only. Schema: {\"class\":\"PAID|DISPUTE|PROMISE_TO_PAY|QUESTION|STOP|GENERAL\",\"sentiment\":\"positive|neutral|negative\",\"disputed\":true|false,\"promise_to_pay\":true|false,\"summary\":\"one sentence for the owner\",\"suggested_reply\":\"professional, courteous, firm-but-respectful 1-2 sentence SMS under 300 chars. If PAID, thank them and say we'll confirm on our end. If DISPUTE, apologize and say the owner will personally review — never argue. If PROMISE_TO_PAY, thank them and confirm. Share the pay link when helpful: {{ $('Find Invoice (Reply)').first().json.Pay_Link }}. NEVER threaten, never mention legal action, never add late fees or interest unless this exact text is provided: {{ $env.LATE_FEE_TEXT }}.\"}. No text outside the JSON object."
            },
            { "role": "user", "content": "=Customer reply: \"{{ $('Normalize Reply').item.json.message_body }}\"" }
          ]
        },
        "jsonOutput": true,
        "options": { "temperature": 0.3 }
      },
      "id": "node-classify",
      "name": "Classify Reply (AI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [120, 760],
      "credentials": { "openAiApi": { "id": "OPENAI_CRED", "name": "P&P OpenAI" } }
    },
    {
      "parameters": {
        "jsCode": "const ai = $('Classify Reply (AI)').first().json.message?.content ?? $('Classify Reply (AI)').first().json;\nlet p;\ntry { p = typeof ai === 'string' ? JSON.parse(ai) : ai; }\ncatch (e) { p = { class:'GENERAL', sentiment:'neutral', disputed:false, promise_to_pay:false, summary:'Could not parse AI output', suggested_reply:'Thanks for your reply — a team member will follow up shortly.' }; }\nconst r = $('Normalize Reply').item.json;\nconst c = $('Find Invoice (Reply)').first().json || {};\nconst cls = String(p.class || 'GENERAL').toUpperCase();\nconst convo = ((c.Conversation || '') + `\\nIN: ${r.message_body}\\nOUT: ${p.suggested_reply}`).trim();\nconst paid = cls === 'PAID';\nconst disputed = cls === 'DISPUTE' || p.disputed === true;\nconst promise = cls === 'PROMISE_TO_PAY' || p.promise_to_pay === true;\nconst statusMap = { PAID:'Paid - Reported', DISPUTE:'Disputed', PROMISE_TO_PAY:'Promised to Pay', QUESTION:'Replied - Question', STOP:'Reminders Stopped - Opted Out', GENERAL:'Replied - General' };\n// Paid (self-report) and dispute STOP the sequence; promise SNOOZES it; others keep it running.\nconst sequence_active = (paid || disputed) ? 'No' : 'Yes';\nconst snoozeDays = Number($env.PROMISE_SNOOZE_DAYS || 5);\nconst next_reminder_at = promise ? $now.plus({ minutes: snoozeDays * 1440 }).toISO() : (c.Next_Reminder_At || '');\nconst wants_contact = /call me|contact me|reach me|call back/i.test(r.message_body || '');\nconst alert_owner = paid || disputed || promise || wants_contact;\nreturn [{ json: { class: cls, sentiment: p.sentiment || 'neutral', disputed, promise, paid, summary: p.summary || '', suggested_reply: p.suggested_reply || 'Thank you!', customer_phone: r.customer_phone, message_body: r.message_body, customer_name: c.Customer_Name || '', balance: c.Balance || '', invoice_number: c.Invoice_Number || '', conversation: convo, new_status: statusMap[cls] || 'Replied - General', sequence_active, next_reminder_at, alert_owner } }];"
      },
      "id": "node-parse-reply",
      "name": "Parse Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 760]
